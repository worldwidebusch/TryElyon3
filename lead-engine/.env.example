# ── lead-engine · omgevingsvariabelen ───────────────────────────────────────
# Kopieer dit bestand naar .env en vul in wat je hebt.
# NIETS is verplicht. De motor draait zonder keys (DuckDuckGo + website-crawl),
# elke key die je toevoegt zet extra bronnen aan.

# ── LLM: ICP-analyse + bronnen vinden ───────────────────────────────────────
# GEMINI is de aanbevolen keuze: die kan Google Search grounding, waardoor het
# model écht op Google zoekt en bronnen met geverifieerde URL's teruggeeft in
# plaats van plausibele URL's die niet bestaan.
# Gratis key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Alternatief (geen grounding vanuit deze tool)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Forceer een provider: gemini | anthropic | auto
LEADENGINE_LLM_PROVIDER=auto

# ── Zoekmachine ─────────────────────────────────────────────────────────────
# Volgorde van voorkeur: google_cse > serper > brave > gemini > duckduckgo
# Forceer met LEADENGINE_SEARCH_PROVIDER=google_cse|serper|brave|gemini|duckduckgo
LEADENGINE_SEARCH_PROVIDER=

# Google Programmable Search Engine — echte Google-resultaten, 100 queries/dag
# gratis. Maak een engine op https://programmablesearchengine.google.com met
# "Zoek op het hele web" AAN, en pak de key op https://developers.google.com/custom-search
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# https://serper.dev  — 2.500 gratis queries, geen dagquotum
SERPER_API_KEY=
# https://brave.com/search/api  — gratis tier 2.000/maand
BRAVE_API_KEY=

# ── Google Maps / Places (lokale NL-bedrijven: kappers, garages, klinieken) ──
# Verreweg de sterkste bron voor lokale MKB-leads met telefoonnummer.
# Mag dezelfde Google Cloud-key zijn als GOOGLE_CSE_KEY, mits je in de console
# de "Places API (New)" hebt aangezet voor dat project.
GOOGLE_PLACES_API_KEY=

# ── KvK Handelsregister (officieel, NL-only) ────────────────────────────────
# https://developers.kvk.nl  — Zoeken API
KVK_API_KEY=

# ── YouTube Data API v3 (podcasts/kanalen waar jouw ICP geïnterviewd wordt) ─
YOUTUBE_API_KEY=

# ── B2B-databases (dekken de "LinkedIn"-behoefte via een legale API) ────────
APOLLO_API_KEY=
# https://hunter.io  — domein -> e-mailadressen + verificatie
HUNTER_API_KEY=
# https://www.zerobounce.net of https://neverbounce.com  — e-mailvalidatie
ZEROBOUNCE_API_KEY=

# ── Gedrag ──────────────────────────────────────────────────────────────────
LEADENGINE_UA=lead-engine/1.0 (+zakelijk contactonderzoek; contact: jij@jouwdomein.nl)
LEADENGINE_MAX_CONCURRENCY=8
LEADENGINE_DELAY_PER_DOMAIN=1.5
LEADENGINE_RESPECT_ROBOTS=true
